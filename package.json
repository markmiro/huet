{
  "name": "huet",
  "homepage": "https://markmiro.com/huet",
  "description": "Color UIs by specifying colors relatively (using HCL, a perceptually accurate color model)",
  "version": "1.0.0-beta.3",
  "author": "Mark Miro",
  "type": "module",
  "keywords": [
    "huet",
    "react",
    "HCL",
    "color",
    "contrast"
  ],
  "main": "./dist/huet.cjs",
  "module": "./dist/huet.js",
  "types": "./dist/huet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/huet.d.ts",
      "import": "./dist/huet.js",
      "require": "./dist/huet.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./images": {
      "types": "./dist/core/images.d.ts",
      "import": "./dist/images.js",
      "require": "./dist/images.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmiro/huet.git"
  },
  "bugs": {
    "url": "https://github.com/markmiro/huet/issues"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "bin": {
    "huet": "dist/check.mjs"
  }
}

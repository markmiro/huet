{
  "name": "huet",
  "version": "1.0.0-alpha.1",
  "description": "Relative UI colors and themed images from one theme, for any framework",
  "license": "MIT",
  "author": "Mark Miro",
  "homepage": "https://markmiro.github.io/huet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmiro/huet.git",
    "directory": "packages/huet"
  },
  "bugs": {
    "url": "https://github.com/markmiro/huet/issues"
  },
  "keywords": [
    "huet",
    "theme",
    "color",
    "contrast",
    "oklab",
    "tailwind",
    "image recolor"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./images": {
      "types": "./dist/core/images.d.ts",
      "import": "./dist/images.js",
      "require": "./dist/images.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./forms.css": "./dist/forms.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@types/chroma-js": "^3.1.3",
    "chroma-js": "^2.6.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "huet": "./dist/check.mjs"
  }
}

{
  "name": "huet",
  "homepage": "https://markmiro.com/huet",
  "description": "Color UIs by specifying colors relatively (using HCL, a perceptually accurate color model)",
  "version": "1.0.0-beta.3",
  "author": "Mark Miro",
  "type": "module",
  "keywords": [
    "huet",
    "react",
    "HCL",
    "color",
    "contrast"
  ],
  "main": "./dist/huet.cjs",
  "module": "./dist/huet.js",
  "types": "./dist/huet.d.ts",
  "exports": {
    ".": {
      "types": "./dist/huet.d.ts",
      "import": "./dist/huet.js",
      "require": "./dist/huet.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.26",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.4",
    "chroma-js": "^2.0.2",
    "file-saver": "^2.0.5",
    "happy-dom": "^21.0.4",
    "lodash": "^4.18.1",
    "map-values": "^1.0.1",
    "nano-css": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons-kit": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmiro/huet.git"
  },
  "bugs": {
    "url": "https://github.com/markmiro/huet/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:lib": "vite build --mode lib && node scripts/copy-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build:lib",
    "test:browser": "playwright test",
    "preview": "astro preview"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "bin": {
    "huet": "dist/check.mjs"
  }
}

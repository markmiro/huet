{
  "name": "huet",
  "version": "2.0.0-alpha.0",
  "description": "Contrast-based color utilities for Tailwind CSS (or plain CSS). Re-theme anything without low-contrast surprises.",
  "homepage": "https://markmiro.com/huet",
  "author": "Mark Miro",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "tailwindcss",
    "tailwind-plugin",
    "color",
    "contrast",
    "theme",
    "oklab",
    "apca",
    "dark-mode"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.js"
    },
    "./huet.css": "./dist/huet.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmiro/huet.git"
  },
  "bugs": {
    "url": "https://github.com/markmiro/huet/issues"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "build:demo": "vite build demo",
    "test": "vitest run test/",
    "test:browser": "node test/browser.ts",
    "typecheck": "tsc --noEmit",
    "legacy": "npm --prefix legacy run dev",
    "prepublishOnly": "npm run build:lib"
  }
}

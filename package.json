{
  "name": "huet-monorepo",
  "private": true,
  "description": "Huet's packages and demo site. The published packages are in packages/.",
  "author": "Mark Miro",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmiro/huet.git"
  },
  "bugs": {
    "url": "https://github.com/markmiro/huet/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:browser": "playwright test",
    "shadcn:setup": "node scripts/shadcn-huet/setup.mjs",
    "shadcn:dev": "pnpm --dir vendor/shadcn-ui --config.package-manager-strict=false v4:dev"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.2",
    "@playwright/test": "^1.64.1",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.4.4",
    "chroma-js": "^2.0.2",
    "happy-dom": "^21.0.4",
    "huet": "workspace:*",
    "huet-react": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons-kit": "^1.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}

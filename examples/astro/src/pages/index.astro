---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>huet + Astro</title>
  </head>
  <body>
    <main class="mx-auto flex max-w-md flex-col gap-4 p-8">
      <div class="flex items-center gap-3 text-sm">
        <label class="flex flex-1 items-center gap-2">
          Background
          <input id="bg" type="range" min="0" max="1" step="0.01" value="1" class="flex-1 accent-100%" />
        </label>
        <select id="theme" class="bg-0% border border-25% rounded px-2 py-1">
          <option value="default">Black / white</option>
          <option value="ocean">Ocean</option>
        </select>
      </div>
      <section id="card" class="bg-5% border border-15% rounded p-4 flex flex-col gap-3">
        <h1 class="text-xl font-semibold">huet + Astro</h1>
        <p class="text-60%">Every color is a contrast amount relative to its parent background.</p>
        <input class="bg-0% border border-25% placeholder-50% rounded px-3 py-2" placeholder="Email address" />
        <button class="bg-100% rounded px-3 py-2 font-medium">Primary action</button>
        <div id="alert" class="hue-red bg-10% border border-30% rounded p-3">Something went wrong.</div>
        <div id="nested" class="bg-5% rounded p-3">Nested card, 5% away from the card.</div>
      </section>
    </main>
    <script>
      import { applyTheme, defaultTheme, type ThemeInput } from "huet";

      const themes: Record<string, ThemeInput> = {
        default: defaultTheme,
        ocean: { dark: "#1d2a3a", light: "#e8f0ff", hues: { red: "#e5484d", blue: "#3e63dd" } },
      };
      const range = document.querySelector<HTMLInputElement>("#bg")!;
      const select = document.querySelector<HTMLSelectElement>("#theme")!;
      // Keep the slider position when switching themes.
      const apply = () =>
        applyTheme(document.documentElement, { ...themes[select.value], bg: range.valueAsNumber });
      range.addEventListener("input", apply);
      select.addEventListener("change", apply);
    </script>
  </body>
</html>

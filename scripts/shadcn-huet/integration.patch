+  /*
+    Recharts 3 moved axis tick text out of .recharts-cartesian-axis-tick, so
+    ChartContainer's fill-muted-foreground no longer reaches it, and polar
+    axis labels never had a rule. Without this, tick labels keep Recharts'
+    #666 and #808080 in every theme. :where() keeps a chart's own tick
+    classes in charge.
+  */
+  :where([data-slot="chart"])
+    :where(

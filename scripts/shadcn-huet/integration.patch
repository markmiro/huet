+  /*
+    Shiki paints plain text as #fff (dark) or #24292e (light). The theme
+    foreground can be dimmer than that. Keep syntax hues; only the plain
+    foreground tokens follow --foreground.
+  */
+  pre[data-language],
+  [data-rehype-pretty-code-figure] pre {
+    --shiki-light: var(--foreground) !important;
+    --shiki-dark: var(--foreground) !important;
+  }
+
+  :is(pre, code, [data-line]) span[style*="#FFF"],
+  :is(pre, code, [data-line]) span[style*="#fff"],
+  :is(pre, code, [data-line]) span[style*="#E1E4E8"],
+  :is(pre, code, [data-line]) span[style*="#e1e4e8"] {
+    --shiki-dark: var(--foreground) !important;
+  }
+
+  :is(pre, code, [data-line]) span[style*="#1F2328"],
+  :is(pre, code, [data-line]) span[style*="#1f2328"],
+  :is(pre, code, [data-line]) span[style*="#24292E"],
+  :is(pre, code, [data-line]) span[style*="#24292e"] {
+    --shiki-light: var(--foreground) !important;
+  }
+
   [data-highlighted-line],
   [data-highlighted-chars] {
     position: relative;
@@ -460,3 +485,21 @@
     @apply rounded-xl border-none bg-clip-padding shadow-2xl ring-4 ring-neutral-200/80 dark:bg-neutral-900 dark:ring-neutral-800;
   }
 }
+
+/* Hide an image until Huet has recolored it, including the first paint, then fade the canvas in once. */
+img:not([data-huet-recolored]) {
+  visibility: hidden;
+}
+
+img[data-huet-recolor][data-huet-recolored] + canvas {
+  animation: huet-image-in 360ms ease both;
+}
+
+@keyframes huet-image-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}

     @apply rounded-xl border-none bg-clip-padding shadow-2xl ring-4 ring-neutral-200/80 dark:bg-neutral-900 dark:ring-neutral-800;
   }
 }
+
+/* Hide an image until Huet has recolored it, including the first paint, then fade the canvas in once. */
+img:not([data-huet-recolored]) {
+  visibility: hidden;
+}
+
+img[data-huet-recolor][data-huet-recolored] + canvas {
+  animation: huet-image-in 360ms ease both;
+}
+
+@keyframes huet-image-in {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}

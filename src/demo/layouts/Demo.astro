---
import "../styles/demo.css";
import ThemeButton from "../components/ThemeButton";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { ic_arrow_back } from "react-icons-kit/md/ic_arrow_back";
import { ic_chevron_right } from "react-icons-kit/md/ic_chevron_right";

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Demos of real sites, listed in their own row of the nav
const websites = [
  { name: "GitHub", href: `${base}github` },
  { name: "YouTube", href: `${base}youtube` },
];
const pages = [
  // The showcase spans the home page and its shadcn page (see Showcase.astro).
  { name: "Showcase", href: base, also: [`${base}shadcn`] },
  { name: "Basic", href: `${base}basic` },
  "websites",
  { name: "Color Contrast", href: `${base}color-contrast` },
  { name: "Images", href: `${base}images` },
  { name: "Code", href: `${base}code` },
  { name: "Forms", href: `${base}forms` },
] as const;
const current = Astro.url.pathname.replace(/(\.html|\/)$/, "") || "/";
const isPath = (href: string) => (href.replace(/\/$/, "") || "/") === current;
const isCurrent = (page: { href: string; also?: readonly string[] }) =>
  isPath(page.href) || (page.also?.some(isPath) ?? false);
const onWebsite = websites.some(isCurrent);
const item = (isActive: boolean) => [
  "rounded px-3 py-1 no-underline",
  isActive ? "huet-bg-100" : "hover:underline",
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Huet Demo</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <noscript><style>#page { visibility: visible !important; }</style></noscript>
  </head>
  <body>
    <div id="page" class="huet-text-100 flex min-h-screen flex-col">
      <!-- Sticky, so the configurator stays in reach while the page scrolls -->
      <header class="huet-bg-10 huet-border-100 sticky top-0 z-10 flex flex-wrap items-center border-b">
        <a href={base} class="flex items-center gap-2 py-2 pr-2 pl-4 font-bold no-underline">
          <Logo size={24} />
          Huet
        </a>
        <nav aria-label="Demos" class="px-2 py-2">
          <div data-nav-row="main" hidden={onWebsite} class="flex flex-wrap items-center gap-1">
            {pages.map((page) =>
              page === "websites" ? (
                <button
                  type="button"
                  data-nav-show="websites"
                  class:list={[item(onWebsite), "flex cursor-pointer items-center gap-0.5 pr-1.5"]}
                >
                  Website Examples
                  <Icon icon={ic_chevron_right} size="1.25em" />
                </button>
              ) : (
                <a href={page.href} aria-current={isCurrent(page) ? "page" : undefined} class:list={item(isCurrent(page))}>
                  {page.name}
                </a>
              ),
            )}
          </div>
          <div data-nav-row="websites" hidden={!onWebsite} class="flex flex-wrap items-center gap-1">
            <button
              type="button"
              data-nav-show="main"
              class:list={[item(false), "flex cursor-pointer items-center gap-1 pl-2"]}
            >
              <Icon icon={ic_arrow_back} size="1.125em" />
              Back
            </button>
            <span class="huet-border-30 mx-1 h-5 border-l" aria-hidden="true"></span>
            {websites.map((page) => (
              <a href={page.href} aria-current={isCurrent(page) ? "page" : undefined} class:list={item(isCurrent(page))}>
                {page.name}
              </a>
            ))}
          </div>
        </nav>
        <ThemeButton client:only="react" />
      </header>
      <main class="flex-auto overflow-clip">
        <slot />
      </main>
    </div>
    <script>
      // "Website Examples" swaps the nav's row for the list of sites, and
      // "Back" swaps it back. Focus moves to the button that swaps it back.
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-nav-show]")) {
        button.addEventListener("click", () => {
          const show = button.dataset.navShow;
          for (const row of document.querySelectorAll<HTMLElement>("[data-nav-row]"))
            row.hidden = row.dataset.navRow !== show;
          document.querySelector<HTMLButtonElement>(`[data-nav-row="${show}"] [data-nav-show]`)!.focus();
        });
      }
    </script>
  </body>
</html>

<style>
  /* Shiki's <pre> blocks, styled like GitHub's rendered Markdown */
  .readme :global(pre) {
    border-radius: 0.375rem;
    padding: 1rem;
    overflow-x: auto;
    font-size: 85%;
    line-height: 1.45;
  }
  /* Diff rows span the block, edge to edge, with markers in the row's own solved colors */
  .readme :global(pre .line) {
    display: inline-block;
    box-sizing: border-box;
    min-width: calc(100% + 2rem);
    margin-inline: -1rem;
    padding-inline: 1rem;
  }
  .readme :global(pre.has-diff .line::before) {
    content: "  ";
  }
  .readme :global(pre.has-diff .line.add::before) {
    content: "+ ";
    color: var(--huet-green);
  }
  .readme :global(pre.has-diff .line.remove::before) {
    content: "- ";
    color: var(--huet-red);
  }
</style>

              <Code code={migrate} lang="html" theme={theme} transformers={transformers} />

              <h3 class="huet-border-20 border-b pt-4 pb-2 text-[1.5em] font-semibold">Themed images</h3>
              <p>
                <code class={inline}>huet/images</code> reads each pixel as a position on Huet's default ramps
                and writes it back at the same position in your theme. Grays follow your neutral ramp, and
                greens become your green. Screenshots work too:
              </p>
              <img data-huet-recolor src={photo("Github theme red")} alt="A GitHub theme for VS Code, in red" class="huet-border-20 w-full rounded-md border" />

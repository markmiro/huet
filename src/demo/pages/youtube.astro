---
import { ic_add } from "react-icons-kit/md/ic_add";
import { ic_check_circle } from "react-icons-kit/md/ic_check_circle";
import { ic_chevron_right } from "react-icons-kit/md/ic_chevron_right";
import { ic_closed_caption } from "react-icons-kit/md/ic_closed_caption";
import { ic_content_cut } from "react-icons-kit/md/ic_content_cut";
import { ic_crop_landscape } from "react-icons-kit/md/ic_crop_landscape";
import { ic_expand_more } from "react-icons-kit/md/ic_expand_more";
import { ic_favorite } from "react-icons-kit/md/ic_favorite";
import { ic_file_download } from "react-icons-kit/md/ic_file_download";
import { ic_fullscreen } from "react-icons-kit/md/ic_fullscreen";
import { ic_menu } from "react-icons-kit/md/ic_menu";
import { ic_mic } from "react-icons-kit/md/ic_mic";
import { ic_more_horiz } from "react-icons-kit/md/ic_more_horiz";
import { ic_more_vert } from "react-icons-kit/md/ic_more_vert";
import { ic_notifications_none } from "react-icons-kit/md/ic_notifications_none";
import { ic_pause } from "react-icons-kit/md/ic_pause";
import { ic_picture_in_picture_alt } from "react-icons-kit/md/ic_picture_in_picture_alt";
import { ic_playlist_add } from "react-icons-kit/md/ic_playlist_add";
import { ic_playlist_play } from "react-icons-kit/md/ic_playlist_play";
import { ic_search } from "react-icons-kit/md/ic_search";
import { ic_settings } from "react-icons-kit/md/ic_settings";
import { ic_share } from "react-icons-kit/md/ic_share";
import { ic_skip_next } from "react-icons-kit/md/ic_skip_next";
import { ic_sort } from "react-icons-kit/md/ic_sort";
import { ic_thumb_down } from "react-icons-kit/md/ic_thumb_down";
import { ic_thumb_up } from "react-icons-kit/md/ic_thumb_up";
import { ic_volume_up } from "react-icons-kit/md/ic_volume_up";

import Icon from "../components/Icon.astro";
import YouTubeLogo from "../components/YouTubeLogo.astro";
import Demo from "../layouts/Demo.astro";
import { images } from "../recolor/data";

const photo = (title: string) => images.find((image) => image.title === title)!.url;
const bee = photo("Honeybee on an aster");

// The progress bar's chapters, as fractions of the video
const chapters = [
  { title: "Dawn on the aster", start: 0, at: "0:00", crop: "origin-[15%_85%]" },
  { title: "Landing", start: 0.12, at: "2:15", crop: "origin-[35%_45%]" },
  { title: "Pollen baskets", start: 0.31, at: "5:49", crop: "origin-[60%_60%]" },
  { title: "The waggle dance", start: 0.58, at: "10:53", crop: "origin-[55%_20%]" },
  { title: "Back to the hive", start: 0.8, at: "15:01", crop: "origin-[90%_10%]" },
];
const played = 0.36;
const buffered = 0.52;
const hovered = 2;

const chips = ["All", "From Tiny Worlds", "Insects", "Nature documentaries", "Related", "Recently uploaded", "Watched"];

const upNext = [
  { image: "Nautilus shell", title: "Why the nautilus shell isn't really a golden spiral", channel: "Number Garden", verified: true, meta: "2.1M views · 3 weeks ago", duration: "14:51" },
  { image: "Mountain lake", title: "I spent 30 days alone at a mountain lake with no phone", channel: "Ellis Outdoors", verified: true, meta: "4.8M views · 1 year ago", duration: "24:18", progress: 0.6 },
  { image: "Candlelit restaurant", title: "Sunday service from a candlelit kitchen, live and unedited", channel: "Ember & Oak", meta: "2.4K watching", live: true },
  { image: "Produce market", title: "Tokyo's oldest produce market at 4 a.m.", channel: "Street Level", meta: "893K views · 5 days ago", duration: "18:02", badge: "New" },
  { image: "Lichen on rock", title: "Lichen is two organisms pretending to be one", channel: "Tiny Worlds", verified: true, meta: "1.1M views · 2 months ago", duration: "11:27", progress: 1 },
  { image: "Snowy mountain village", title: "A winter in the highest village in Europe", channel: "Far North Films", meta: "3.3M views · 8 months ago", duration: "41:09" },
  { image: "Forest in daylight", title: "Rain on a forest floor · 3 hours of ambient sound for sleep and focus", channel: "Quiet Places", meta: "12M views · 2 years ago", duration: "3:02:14" },
  { image: "City skyline at dusk", title: "Golden hour over the city · 8K timelapse", channel: "Long Exposure", verified: true, meta: "640K views · 4 months ago", duration: "6:30" },
  { image: "Rugby match", title: "The greatest try ever scored? Breaking it down frame by frame", channel: "The Breakdown", meta: "2.7M views · 1 year ago", duration: "22:45", progress: 0.25 },
  { image: "Table of food", title: "Cooking every recipe from a 1920s cookbook", channel: "Ember & Oak", meta: "1.9M views · 6 months ago", duration: "32:10" },
  { image: "Beach, sea and sky", title: "Mix · Calm ocean waves", channel: "Quiet Places, Long Exposure and more", meta: "Updated today", playlist: "50+ videos" },
  { image: "Kitchen in morning sun", title: "My slow morning routine in a 200-year-old farmhouse", channel: "Slow Days", meta: "5.2M views · 3 years ago", duration: "16:44" },
];

const comments = [
  {
    photo: photo("Woman, white background"),
    handle: "@marenholt",
    when: "2 days ago",
    text: "The moment at 6:41 where the pollen basket fills up in real time is unreal. I've kept bees for eleven years and never seen it this close.",
    likes: "8.4K",
    replies: 112,
    pinned: true,
    hearted: true,
  },
  {
    letter: "D",
    avatar: "huet-bg-purple-60",
    handle: "@dmitri.k",
    when: "1 day ago",
    text: "Fun fact: a honeybee visits 50–100 flowers on a single foraging trip, and this one is doing it on what's basically a purple trampoline.",
    likes: "3.1K",
    replies: 24,
    hearted: true,
  },
  {
    letter: "O",
    avatar: "huet-bg-red-60",
    handle: "@owenmakesthings",
    when: "1 day ago",
    text: "What lens is this? The depth of field on the wings at 10:53 looks like focus stacking but it's moving footage.",
    likes: "1.2K",
    replies: 9,
  },
  {
    owner: true,
    handle: "@TinyWorlds",
    when: "1 day ago (edited)",
    text: "Thanks everyone! It's a 100 mm macro on a slider, shot at 120 fps. Full kit list is in the description. Next episode: the inside of the hive.",
    likes: "5.6K",
    replies: 41,
  },
  {
    letter: "S",
    avatar: "huet-bg-green-60",
    handle: "@sunnyside_apiary",
    when: "20 hours ago",
    text: "Showing this to my kids tonight. They keep asking why the bees 'dance' and the chapter at 10:53 explains it better than I ever could.",
    likes: "642",
  },
  {
    photo: photo("Woman, grey backdrop"),
    handle: "@ines.paints",
    when: "14 hours ago",
    text: "Paused at 3:20 to use as a painting reference. The color in this whole video is gorgeous.",
    likes: "318",
    replies: 3,
  },
  {
    letter: "R",
    avatar: "huet-bg-yellow-60",
    handle: "@rafa_outdoors",
    when: "5 hours ago",
    text: "Asters in late October are a lifeline for bees before winter. Plant them, people!",
    likes: "97",
  },
];

const pill = "huet-bg-5 hover:huet-bg-10 flex h-9 items-center gap-2 rounded-full px-4 font-medium";
const iconButton = "hover:huet-bg-10 flex size-10 items-center justify-center rounded-full";
const playerButton = "flex size-10 items-center justify-center";
const verified = "huet-text-50 inline-flex align-[-2px]";
---
<Demo title="YouTube">
  <div class="text-sm/normal">
    <!-- Masthead -->
    <header class="huet-bg-0 sticky top-0 z-10 flex h-14 items-center justify-between gap-4 px-4">
      <div class="flex shrink-0 items-center gap-4">
        <button aria-label="Guide" class={iconButton}><Icon icon={ic_menu} size={24} /></button>
        <a href="#" aria-label="YouTube Home" class="flex items-start gap-0.5">
          <YouTubeLogo class="h-5" />
          <span class="huet-text-60 -mt-1 text-[10px]">US</span>
        </a>
      </div>
      <div class="hidden max-w-[40em] flex-1 items-center gap-4 sm:flex">
        <div class="flex flex-1">
          <!-- Placeholder: 50 against the input's own background. Typed text keeps
               the input's foreground. -->
          <input
            placeholder="Search"
            aria-label="Search"
            value="honeybee macro 4k"
            class="huet-bg-0 huet-border-30 huet-bg/text-50 text-huet-fg placeholder:text-(--huet-relative-text) min-w-0 flex-1 rounded-l-full border px-4 py-2 shadow-[inset_0_1px_2px_rgb(0_0_0/0.1)] focus-visible:outline-none focus-visible:huet-border-blue-60"
          />
          <button aria-label="Search" class="huet-bg-5 hover:huet-bg-10 huet-bg/border-30 flex w-16 items-center justify-center rounded-r-full border border-l-0">
            <Icon icon={ic_search} size={24} />
          </button>
        </div>
        <button aria-label="Search with your voice" class="huet-bg-5 hover:huet-bg-10 flex size-10 shrink-0 items-center justify-center rounded-full">
          <Icon icon={ic_mic} size={24} />
        </button>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <button class={`${pill} hidden md:flex`}><Icon icon={ic_add} size={24} />Create</button>
        <button aria-label="Notifications, 9+ unread" class={`${iconButton} relative`}>
          <Icon icon={ic_notifications_none} size={24} />
          <span class="huet-bg-red-100 huet-bg/text-white-100 absolute top-0.5 right-0 rounded-full px-1 text-[11px] leading-4 font-medium">9+</span>
        </button>
        <img data-huet-recolor src={photo("Man, grey wall")} alt="Your account" class="ml-2 size-8 rounded-full object-cover object-top" />
      </div>
    </header>

    <div class="mx-auto flex max-w-[1754px] flex-col gap-6 px-4 pt-4 pb-10 xl:flex-row xl:px-6">
      <!-- Watch column -->
      <main class="min-w-0 flex-1">
        <div class="relative">
          <!-- Ambient mode: a blurred, recolored copy of the frame glows behind the player -->
          <img data-huet-recolor src={bee} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 size-full scale-[1.04] rounded-xl object-cover opacity-50 blur-3xl" />

          <div class="huet-bg-100 relative aspect-video overflow-hidden rounded-xl">
            <img data-huet-recolor src={bee} alt="A honeybee gathering pollen on a purple aster" class="absolute inset-0 size-full object-cover" />
            <!-- A scrim in the player's own color, so the controls on it stay readable -->
            <span class="huet-text-0 pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-[linear-gradient(transparent,currentColor)] opacity-80"></span>
            <span class="huet-text-0 pointer-events-none absolute inset-x-0 top-0 h-24 bg-[linear-gradient(currentColor,transparent)] opacity-60"></span>

            <div class="absolute inset-x-0 top-0 hidden items-center gap-3 p-4 sm:flex">
              <img data-huet-recolor src={photo("Lichen on rock")} alt="" class="size-10 rounded-full object-cover" />
              <span class="truncate text-lg font-medium">The secret life of a honeybee, filmed on a single aster</span>
            </div>

            <div class="absolute inset-x-0 bottom-0 px-3">
              <!-- Storyboard preview where the pointer is over the progress bar -->
              <div class="absolute bottom-[4.25rem] left-[44%] hidden md:flex -translate-x-1/2 flex-col items-center gap-1">
                <span class="huet-bg-100 block overflow-hidden rounded-lg p-0.5">
                  <span class="block overflow-hidden rounded-md">
                    <img data-huet-recolor src={bee} alt="" class="block aspect-video w-40 scale-[2.2] object-cover origin-[60%_60%]" />
                  </span>
                </span>
                <span class="text-xs font-medium">{chapters[hovered].title}</span>
                <span class="text-sm font-semibold">8:16</span>
              </div>

              <!-- Progress bar: each chapter is its own track -->
              <div class="relative flex h-4 items-center gap-0.5">
                {chapters.map((c, i) => {
                  const end = chapters[i + 1]?.start ?? 1;
                  const fill = (to: number) => `${Math.max(0, Math.min(1, (to - c.start) / (end - c.start))) * 100}%`;
                  return (
                    <span
                      class:list={["huet-bg-30 relative block overflow-hidden rounded-full", i === hovered ? "h-1.5" : "h-1"]}
                      style={`width: ${(end - c.start) * 100}%`}
                    >
                      <span class="huet-bg-60 absolute inset-y-0 left-0 block" style={`width: ${fill(buffered)}`}></span>
                      <span class="huet-bg-red-100 absolute inset-y-0 left-0 block" style={`width: ${fill(played)}`}></span>
                    </span>
                  );
                })}
                <span class="huet-bg-red-100 absolute top-1/2 block size-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full" style={`left: ${played * 100}%`}></span>
              </div>

              <div class="flex h-12 items-center justify-between">
                <div class="flex min-w-0 items-center">
                  <button aria-label="Pause" class={playerButton}><Icon icon={ic_pause} size={30} /></button>
                  <button aria-label="Next" class={playerButton}><Icon icon={ic_skip_next} size={28} /></button>
                  <button aria-label="Mute" class={playerButton}><Icon icon={ic_volume_up} size={26} /></button>
                  <span class="hidden h-1 w-16 overflow-hidden rounded-full sm:flex">
                    <span class="huet-bg-100 block w-3/4"></span>
                    <span class="huet-bg-30 block flex-1"></span>
                  </span>
                  <span class="ml-3 shrink-0 text-[13px] tabular-nums">6:41 / 18:47</span>
                  <span class="ml-3 hidden items-center truncate text-[13px] md:flex">· {chapters[2].title}<Icon icon={ic_chevron_right} size={18} /></span>
                </div>
                <div class="flex shrink-0 items-center">
                  <span role="switch" aria-checked="true" aria-label="Autoplay" class="huet-bg-40 relative mx-2 hidden h-3.5 w-9 rounded-full sm:block">
                    <span class="huet-bg-100 absolute top-1/2 right-0 flex size-5 -translate-y-1/2 items-center justify-center rounded-full shadow">
                      <span class="block size-0 border-y-[4px] border-l-[6px] border-y-transparent"></span>
                    </span>
                  </span>
                  <button aria-label="Subtitles" class={`${playerButton} relative`}>
                    <Icon icon={ic_closed_caption} size={26} />
                    <span class="huet-bg-red-100 absolute bottom-2 left-2.5 block h-0.5 w-5 rounded-full"></span>
                  </button>
                  <button aria-label="Settings" class={`${playerButton} relative`}>
                    <Icon icon={ic_settings} size={24} />
                    <span class="huet-bg-red-100 huet-bg/text-white-100 absolute top-1.5 right-0 rounded-xs px-0.5 text-[8px] leading-tight font-bold">4K</span>
                  </button>
                  <button aria-label="Miniplayer" class={`${playerButton} hidden sm:flex`}><Icon icon={ic_picture_in_picture_alt} size={22} /></button>
                  <button aria-label="Theater mode" class={`${playerButton} hidden sm:flex`}><Icon icon={ic_crop_landscape} size={26} /></button>
                  <button aria-label="Full screen" class={playerButton}><Icon icon={ic_fullscreen} size={28} /></button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <h1 class="mt-3 text-xl/7 font-bold">The secret life of a honeybee, filmed on a single aster | 4K macro</h1>

        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <img data-huet-recolor src={photo("Lichen on rock")} alt="Tiny Worlds" class="size-10 rounded-full object-cover" />
            <div class="mr-3">
              <a href="#" class="text-base font-semibold">Tiny Worlds <span class={verified}><Icon icon={ic_check_circle} size={14} /></span></a>
              <div class="huet-text-60 text-xs">1.84M subscribers</div>
            </div>
            <button class="huet-bg/border-30 hover:huet-bg-10 h-9 rounded-full border px-4 font-medium">Join</button>
            <button class="huet-bg-100 hover:huet-bg-80 h-9 rounded-full px-4 font-medium">Subscribe</button>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <div class="huet-bg-5 flex h-9 items-center overflow-hidden rounded-full">
              <button aria-label="Like this video along with 48K other people" class="hover:huet-bg-10 flex h-full items-center gap-2 pr-3 pl-4 font-medium">
                <Icon icon={ic_thumb_up} size={20} />48K
              </button>
              <span class="huet-bg-20 block h-6 w-px"></span>
              <button aria-label="Dislike this video" class="hover:huet-bg-10 flex h-full items-center pr-4 pl-3"><Icon icon={ic_thumb_down} size={20} /></button>
            </div>
            <button class={pill}><Icon icon={ic_share} size={20} />Share</button>
            <button class={`${pill} hidden sm:flex`}><Icon icon={ic_file_download} size={20} />Download</button>
            <button class={`${pill} hidden lg:flex`}><Icon icon={ic_content_cut} size={20} />Clip</button>
            <button class={`${pill} hidden lg:flex`}><Icon icon={ic_playlist_add} size={20} />Save</button>
            <button aria-label="More actions" class="huet-bg-5 hover:huet-bg-10 flex size-9 items-center justify-center rounded-full"><Icon icon={ic_more_horiz} size={20} /></button>
          </div>
        </div>

        <!-- Description -->
        <div class="huet-bg-5 hover:huet-bg-10 mt-3 rounded-xl p-3">
          <p class="font-semibold">1,284,093 views  Premiered Oct 30, 2026 <span class="huet-text-blue-100">#macro #honeybee #nature</span></p>
          <p class="mt-1">
            We spent three mornings on one aster in our garden, waiting for the same bee to come back.
            Shot on a 100 mm macro lens at 120 fps, then slowed down so you can watch the pollen baskets fill.
          </p>
          <p class="mt-3">Chapters</p>
          <ul class="mt-1">
            {chapters.map((c) => (
              <li><a href="#" class="huet-text-blue-100 hover:underline">{c.at}</a> {c.title}</li>
            ))}
          </ul>
          <div class="mt-3 flex gap-2 overflow-x-auto pb-1">
            {chapters.map((c, i) => (
              <a href="#" class:list={["flex w-[11em] shrink-0 flex-col rounded-lg p-1.5", i === hovered ? "huet-bg-20" : "hover:huet-bg-20"]}>
                <span class="block overflow-hidden rounded-md">
                  <img data-huet-recolor src={bee} alt="" class={`block aspect-video w-full scale-[2.2] object-cover ${c.crop}`} />
                </span>
                <span class="mt-1.5 line-clamp-1 font-medium">{c.title}</span>
                <span class="huet-bg-10 mt-1 self-start rounded px-1 text-xs font-medium">{c.at}</span>
              </a>
            ))}
          </div>
          <button class="mt-2 font-semibold">Show less</button>
        </div>

        <!-- Comments -->
        <section class="mt-6">
          <div class="flex items-center gap-8">
            <h2 class="text-xl font-bold">4,127 Comments</h2>
            <button class="flex items-center gap-2 font-medium"><Icon icon={ic_sort} size={24} />Sort by</button>
          </div>
          <div class="mt-6 flex gap-4">
            <img data-huet-recolor src={photo("Man, grey wall")} alt="" class="size-10 shrink-0 rounded-full object-cover object-top" />
            <div class="huet-border-30 huet-text-60 flex-1 border-b pb-1">Add a comment…</div>
          </div>

          <ul class="mt-8 space-y-6">
            {comments.map((c) => (
              <li class="flex gap-4">
                {c.photo ? (
                  <img data-huet-recolor src={c.photo} alt="" class="size-10 shrink-0 rounded-full object-cover object-top" />
                ) : c.owner ? (
                  <img data-huet-recolor src={photo("Lichen on rock")} alt="" class="size-10 shrink-0 rounded-full object-cover" />
                ) : (
                  <span class={`${c.avatar} flex size-10 shrink-0 items-center justify-center rounded-full text-lg font-medium`}>{c.letter}</span>
                )}
                <div class="min-w-0 flex-1">
                  {c.pinned && <p class="huet-text-60 mb-1 text-xs">📌 Pinned by @TinyWorlds</p>}
                  <p class="text-[13px]">
                    {c.owner ? (
                      <span class="huet-bg-20 rounded-full px-1.5 py-0.5 font-medium">{c.handle} <span class="inline-flex align-[-2px]"><Icon icon={ic_check_circle} size={12} /></span></span>
                    ) : (
                      <span class="font-medium">{c.handle}</span>
                    )}
                    <span class="huet-text-60 ml-1">{c.when}</span>
                  </p>
                  <p class="mt-0.5">
                    {c.text.split(/(\d+:\d\d)/).map((part, i) =>
                      i % 2 ? <a href="#" class="huet-text-blue-100 hover:underline">{part}</a> : part,
                    )}
                  </p>
                  <div class="huet-text-60 mt-1 flex items-center gap-1 text-xs">
                    <button aria-label="Like" class="hover:huet-bg-10 huet-text-100 flex size-8 items-center justify-center rounded-full"><Icon icon={ic_thumb_up} size={16} /></button>
                    <span>{c.likes}</span>
                    <button aria-label="Dislike" class="hover:huet-bg-10 huet-text-100 ml-2 flex size-8 items-center justify-center rounded-full"><Icon icon={ic_thumb_down} size={16} /></button>
                    {c.hearted && (
                      <span title="Hearted by Tiny Worlds" class="relative ml-1 size-6">
                        <img data-huet-recolor src={photo("Lichen on rock")} alt="" class="size-6 rounded-full object-cover" />
                        <span class="huet-text-red-100 absolute -right-1.5 -bottom-1.5"><Icon icon={ic_favorite} size={14} /></span>
                      </span>
                    )}
                    <button class="hover:huet-bg-10 huet-text-100 ml-2 rounded-full px-3 py-1.5 font-medium">Reply</button>
                  </div>
                  {c.replies && (
                    <button class="huet-text-blue-100 hover:huet-bg-blue-10 -ml-3 flex items-center gap-1.5 rounded-full px-3 py-1.5 font-medium">
                      <Icon icon={ic_expand_more} size={22} />{c.replies} {c.replies === 1 ? "reply" : "replies"}
                    </button>
                  )}
                </div>
                <button aria-label="Action menu" class={`${iconButton} shrink-0`}><Icon icon={ic_more_vert} size={20} /></button>
              </li>
            ))}
          </ul>
        </section>
      </main>

      <!-- Up next -->
      <aside class="shrink-0 xl:w-[402px]">
        <div class="-mx-1 flex gap-3 overflow-x-auto px-1 pb-3">
          {chips.map((chip, i) => (
            <button class:list={["h-8 shrink-0 rounded-lg px-3 font-medium", i === 0 ? "huet-bg-100" : "huet-bg-5 hover:huet-bg-10"]}>{chip}</button>
          ))}
        </div>
        <ul class="space-y-2">
          {upNext.map((v) => (
            <li>
              <a href="#" class="group hover:huet-bg-5 -m-1 flex gap-2 rounded-xl p-1">
                <span class="huet-bg-10 relative block aspect-video w-[168px] shrink-0 overflow-hidden rounded-lg">
                  <img data-huet-recolor src={photo(v.image)} alt="" loading="lazy" class="absolute inset-0 size-full object-cover" />
                  {v.duration && (
                    <span class="huet-bg-100 absolute right-1 bottom-1 rounded px-1 text-xs font-medium">{v.duration}</span>
                  )}
                  {v.live && (
                    <span class="huet-bg-red-100 huet-bg/text-white-100 absolute right-1 bottom-1 rounded px-1 text-xs font-semibold">● LIVE</span>
                  )}
                  {v.playlist && (
                    <span class="huet-bg-100 absolute inset-y-0 right-0 flex w-2/5 flex-col items-center justify-center gap-0.5 text-xs font-medium">
                      <Icon icon={ic_playlist_play} size={22} />{v.playlist}
                    </span>
                  )}
                  {v.progress && (
                    <span class="huet-bg-40 absolute inset-x-0 bottom-0 block h-1">
                      <span class="huet-bg-red-100 block h-full" style={`width: ${v.progress * 100}%`}></span>
                    </span>
                  )}
                </span>
                <span class="min-w-0 flex-1 pr-6">
                  <span class="line-clamp-2 font-semibold">{v.title}</span>
                  <span class="huet-text-60 mt-1 block text-xs">
                    {v.channel}
                    {v.verified && <span class="inline-flex align-[-2px]"><Icon icon={ic_check_circle} size={12} /></span>}
                  </span>
                  <span class="huet-text-60 block text-xs">{v.meta}</span>
                  {v.badge && <span class="huet-bg-10 mt-1 inline-block rounded px-1 text-xs font-medium">{v.badge}</span>}
                  {v.live && <span class="huet-bg-red-10 huet-bg/text-red-100 mt-1 inline-block rounded px-1 text-xs font-semibold">LIVE</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="huet-bg/border-30 hover:huet-bg-blue-10 huet-text-blue-100 mt-4 h-9 w-full rounded-full border font-medium">Show more</button>
      </aside>
    </div>
  </div>
</Demo>

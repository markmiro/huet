---
import Showcase from "../layouts/Showcase.astro";
import CodeCard from "../shadcn/CodeCard.astro";
import {
  AlertsStack,
  DesignReviewCard,
  GalleryCard,
  IssuesCard,
  SignUpCard,
  SpendingCard,
  TeamCard,
} from "../shadcn/cards";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Showcase title="Showcase">
  <!--
    Laid out for a 14-inch laptop (about 1512 × 860 inside the browser): the
    cards fill the screen in four columns, two cards each.
  -->
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 px-6 pt-5">
    <h1 class="text-xl font-semibold tracking-tight">Huet showcase</h1>
    <p class="text-sm text-muted-foreground">
      shadcn components, themed by Huet. Pick a theme with the button at the top right.
    </p>
    <a href={`${base}shadcn`} class="ml-auto text-sm text-muted-foreground underline-offset-4 hover:underline">
      Every state, in the shadcn integration →
    </a>
  </div>
  <div class="grid items-start gap-5 p-6 md:grid-cols-2 xl:grid-cols-4 **:data-[slot=card]:w-full">
    <div class="flex flex-col gap-5">
      <TeamCard client:load />
      <SignUpCard client:load />
    </div>
    <div class="flex flex-col gap-5">
      <GalleryCard client:load />
      <DesignReviewCard client:load />
    </div>
    <div class="flex flex-col gap-5">
      <SpendingCard client:load />
      <IssuesCard client:load />
    </div>
    <div class="flex flex-col gap-5">
      <CodeCard />
      <AlertsStack client:load />
    </div>
  </div>
</Showcase>

---
import Section from "../components/Section.astro";
import Demo from "../layouts/Demo.astro";
import { images } from "../recolor/data";
import marketPoster from "../assets/video/market-poster.jpg?url";
import marketMp4 from "../assets/video/market.mp4?url";
import marketWebm from "../assets/video/market.webm?url";

// Emoji the demo's Twemoji subset holds (src/demo/assets/fonts).
const emojiRows = [
  "🌸🌻🌷🌹🌼🌿🍀🌲🍁🌈🔥💧",
  "🍎🍊🍋🍏🫐🍇🍉🥑🥕🌶️🍄⭐",
  "😀😍🥳😎🤖👻🐸🦊🐝🦋🐳🦜",
  "❤️🧡💛💚💙💜🤎🖤🤍✅🚫👋",
  "👍🏻👍🏼👍🏽👍🏾👍🏿🙌🏻🙌🏽🙌🏿🧑🏻🧑🏽🧑🏿",
];

// A stand-in for an embed from another site, in stock colors Huet can't read.
const embed = `<!doctype html>
<style>
  body { margin: 0; padding: 16px; font: 14px/1.4 system-ui, sans-serif; background: #fff; color: #1f2328; }
  h2 { margin: 0 0 4px; font-size: 16px; }
  p { margin: 0 0 12px; color: #59636e; }
  .row { display: flex; gap: 8px; align-items: center; }
  button { border: 0; border-radius: 6px; padding: 6px 12px; font: inherit; color: #fff; background: #0969da; }
  .ok { color: #1a7f37; } .error { color: #d1242f; }
</style>
<h2>Checkout widget</h2>
<p>An embedded form from another site</p>
<div class="row"><button>Pay $24.00</button><span class="ok">● Connected</span></div>
<p class="error" style="margin: 12px 0 0">Card declined: try another card</p>`;

const unsplash = (kind: string) =>
  images.filter((image) => image.group === "unsplash" && image.kind === kind);
const galleries = [
  {
    title: "Faces",
    note: "Simple portraits from Unsplash: plain backgrounds, soft light",
    images: unsplash("face"),
    fit: "object-cover object-top aspect-[4/5]",
  },
  {
    title: "Macro",
    note: "Close-ups from Unsplash: fine texture and smooth transitions",
    images: unsplash("macro"),
    fit: "object-cover aspect-[4/3]",
  },
  {
    title: "Photos",
    note: "Everyday scenes from Unsplash: depth, haze, mid tones, light and dark",
    images: unsplash("scene"),
    fit: "object-cover aspect-[4/3]",
  },
  {
    title: "Screenshots",
    note: "Project thumbnails from markmiro.com",
    images: images.filter((image) => image.group === "markmiro"),
    fit: "object-contain aspect-[4/3]",
  },
];
---
<Demo title="Images">
  <div class="mx-auto max-w-[70em] p-8">
    <h1 data-theme-name class="my-[0.67em] border-b-[.125em] pb-1 text-5xl font-bold">&nbsp;</h1>
    <p class="huet-text-50 max-w-[40em]">
      Every image here is recolored into the theme you pick in the configurator, using
      <code class="huet-bg-5 rounded-xs px-1 font-mono">huet/images</code>. Grays follow the
      theme's neutral ramp and colors follow its hues. Hover an image to see the original.
    </p>
    <p class="huet-text-50 mt-4">
      Adjust their tint and strength, or turn image or SVG theming off, in the configurator’s Edit Theme tab.
    </p>

    <div class="grid gap-x-12 md:grid-cols-2">
      <Section title="SVG">
        <p class="huet-text-50 -mt-12 mb-6 text-sm">
          An inline SVG recolored as vectors with <code class="huet-bg-5 rounded-xs px-1 font-mono">mountSvgs</code>
        </p>
        <figure class="huet-bg-5 huet-border-10 max-w-[28em] overflow-hidden rounded border">
          <svg id="landscape" data-huet-recolor viewBox="0 0 320 180" role="img" aria-label="Hills under a sun" class="block w-full">
            <defs>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#4a90d9" />
                <stop offset="1" stop-color="#f6d6a8" />
              </linearGradient>
            </defs>
            <rect width="320" height="180" fill="url(#sky)" />
            <circle cx="240" cy="62" r="26" fill="#f4b400" />
            <path d="M0 120 Q80 70 160 112 T320 100 V180 H0Z" fill="#5b8c3a" />
            <path d="M0 146 Q110 108 210 140 T320 136 V180 H0Z" fill="#2f5d34" />
            <path d="M58 136 l10 -26 l10 26Z" fill="#d93f3f" stroke="#1f1f1f" stroke-width="2" />
          </svg>
        </figure>
      </Section>

      <Section title="Video">
        <p class="huet-text-50 -mt-12 mb-6 text-sm">
          Recolored frame by frame with <code class="huet-bg-5 rounded-xs px-1 font-mono">mountVideos</code>. Hover for the original and its controls
        </p>
        <figure class="huet-bg-5 huet-border-10 max-w-[28em] overflow-hidden rounded border">
          <video
            id="market"
            data-huet-recolor
            autoplay
            muted
            loop
            playsinline
            controls
            poster={marketPoster}
            aria-label="Shoppers at a produce market stall"
            class="block aspect-video w-full object-cover"
          >
            <source src={marketWebm} type="video/webm" />
            <source src={marketMp4} type="video/mp4" />
          </video>
        </figure>
      </Section>

      <Section title="Iframe">
        <p class="huet-text-50 -mt-12 mb-6 text-sm">
          Approximated with <code class="huet-bg-5 rounded-xs px-1 font-mono">mountIframes</code>, since its pixels can't be read: black and white are exact, colors aren't. Hover for the original
        </p>
        <figure class="huet-bg-5 huet-border-10 max-w-[28em] overflow-hidden rounded border">
          <iframe
            id="embed"
            data-huet-recolor
            srcdoc={embed}
            title="Checkout widget"
            class="block h-[10.5em] w-full"
          ></iframe>
        </figure>
      </Section>

      <Section title="Emoji">
        <p class="huet-text-50 -mt-12 mb-6 text-sm">
          Selectable text in Twemoji, themed with <code class="huet-bg-5 rounded-xs px-1 font-mono">huet-emoji</code>
        </p>
        <div id="emoji" class="emoji-text huet-bg-5 huet-border-10 max-w-[28em] rounded border p-4">
          <p>Build passed ✅ and shipped 🚀 Thanks, everyone 🎉❤️</p>
          {emojiRows.map((row) => <p class="mt-2 text-3xl tracking-wider">{row}</p>)}
        </div>
      </Section>
    </div>

    {galleries.map((gallery) => (
      <Section title={gallery.title}>
        <p class="huet-text-50 -mt-12 mb-6 text-sm">{gallery.note}</p>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(14em,1fr))] gap-4">
          {gallery.images.map((image) => (
            <figure class="huet-bg-5 huet-border-10 overflow-hidden rounded border">
              <img
                data-huet-recolor
                src={image.url}
                alt={image.title}
                loading="lazy"
                class={`block w-full ${gallery.fit}`}
              />
              <figcaption class="flex items-center justify-between gap-2 p-2 text-sm">
                <span class="truncate">{image.title}</span>
                <a href={image.source} class="huet-text-blue-100 shrink-0 underline">Source</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </Section>
    ))}
  </div>
</Demo>

<style is:global>
  /* The emoji font goes first in the stack; unicode-range keeps it to emoji. */
  @font-face {
    font-family: "Twemoji";
    src: url("../assets/fonts/twemoji-demo.woff2") format("woff2");
    unicode-range: U+200D, U+FE0F, U+20E3, U+231A-23FF, U+2600-27BF, U+2B05-2B55, U+1F000-1FAFF, U+E0020-E007F;
  }
  .emoji-text {
    font-family: "Twemoji", ui-sans-serif, system-ui, sans-serif;
  }
</style>
